+extern void *_charTables[];
+static unsigned s_waitWeeks=0;
+static int s_waitAccepted=0;
+static uint16_t s_waitTeam=0;
+static char s_waitTeamName[40]="";
+void Expanded_UnemployedInit(void) {
+    extern MenuEntry _menuEntries[];
+    _menuEntries[2].isInvisible=(s_waitWeeks<4);
+    _menuEntries[1].isInvisible=(s_waitWeeks>=4);
+}
+void Expanded_UnemployedDraw(void) {
+    char line[90];
+    /* A deliberately empty 4x5 fixture calendar, in native 320x256. */
+    for(int col=0;col<4;col++) for(int row=0;row<5;row++) {
+        FillRectangle((uint16_t)(35+col*63),(uint16_t)(30+row*21),58,17,8);
+        FillRectangle((uint16_t)(36+col*63),(uint16_t)(31+row*21),56,15,0);
+    }
+    snprintf(line,sizeof line,"WEEK %u - NO CLUB / NO FIXTURES",s_waitWeeks+1);
+    DrawMenuTextCentered(160,143,7,(uint8_t*)line,(uint8_t*)_charTables[0]);
+    if(s_waitWeeks>=4) {
+        snprintf(line,sizeof line,"JOB OFFER: %.27s",s_waitTeamName);
+        DrawMenuTextCentered(160,155,2,(uint8_t*)line,(uint8_t*)_charTables[0]);
+    } else {
+        DrawMenuTextCentered(160,155,7,(uint8_t*)"WAITING FOR A SMALL CLUB OFFER",(uint8_t*)_charTables[0]);
+    }
+}
+void Expanded_UnemployedWait(void) {
+    if(s_waitWeeks<4) s_waitWeeks++;
+    Expanded_UnemployedInit();
+    DrawMenu();
+}
+void Expanded_UnemployedAccept(void) {
+    if(s_waitWeeks<4 || !s_waitTeam) return;
+    s_waitAccepted=1;
+    SetExitMenuFlag();
+}
+/* Choose the lowest-division English club from real team data, never a
+ * synthetic or out-of-range team number. The loader swaps file count to
+ * host endian on SDL; team IDs are two independent bytes. */
+static uint16_t find_small_club(void) {
+    _teamsLoaded=0;
+    if(LoadTeamFile(8)!=0) return 0;
+    uint16_t count=*(const uint16_t*)_teamFileBuffer;
+    if(!count || count>93) return 0;
+    const TeamFileEx *teams=(const TeamFileEx*)(_teamFileBuffer+2);
+    const TeamFileEx *best=0;
+    for(unsigned i=0;i<count;i++) {
+        const TeamFileEx *t=&teams[i];
+        if(t->team.countryNumber!=8 || t->team.league>=4) continue;
+        if(!best || t->team.league>best->team.league ||
+           (t->team.league==best->team.league && i>0)) best=t;
+    }
+    if(!best) return 0;
+    snprintf(s_waitTeamName,sizeof s_waitTeamName,"%.17s",(const char*)best->team.teamName);
+    return (uint16_t)((best->team.countryNumber<<8)|best->team.teamOrdinal);
+}
+int Expanded_WaitForFirstOffer(uint16_t *team) {
+    if(!team) return 0;
+    s_waitTeam=find_small_club();
+    if(!s_waitTeam) {
+        fprintf(stderr,"[expanded08] no valid weak club found in TEAM.008\n");
+        return 0;
+    }
+    s_waitWeeks=0; s_waitAccepted=0;
+    ShowMenu(_expandedUnemployedMenu);
+    if(!s_waitAccepted) return 0;
+    *team=s_waitTeam;
+    return 1;
+}
