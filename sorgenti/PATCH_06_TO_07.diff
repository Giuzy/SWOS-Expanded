+/* Page changes happen INSIDE the active modal. No nested ShowMenu,
+ * no parent-menu flash, no click being replayed into the career screen. */
+void Expanded_NationalityChangePage(int delta) {
+    int next = (int)_expandedNationalityPage + delta;
+    if (next < 0 || next * 10 >= Expanded_NationalityTotal()) return;
+    int32_t count;
+    const uint8_t *table = career_nationalities(&count);
+    _expandedNationalityPage = (uint8_t)next;
+    Expanded_NationalityPickerPopulate(table, count);
+    Expanded_NationalityMenuInit();
+    ((Menu *)_currentMenu)->selectedEntry = &_menuEntries[1];
+    DrawMenu();
 }
 
