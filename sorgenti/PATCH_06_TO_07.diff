+/* Expanded 0.7 club overview: hand-painted rectangles at native 320x256
+ * coordinates, rendered with SWOS's own palette and bitmap font. This is
+ * genuine in-engine pixel art, not a high-resolution SDL overlay. */
+#include "blitter.h"
